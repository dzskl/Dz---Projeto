# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).

# Porta do servidor
PORT=3000

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=cole_sua_chave_aqui

# Senha do painel de administração (use uma senha forte e única).
# Sem ela, as rotas de admin ficam BLOQUEADAS por segurança.
ADMIN_PASSWORD=defina_uma_senha_forte_aqui

# Segredo para assinar os tokens de login (JWT). Gere algo aleatório e longo.
# Ex (linux): openssl rand -hex 32
JWT_SECRET=defina_um_segredo_aleatorio_longo

# (Opcional) Domínios liberados no CORS, separados por vírgula.
# Ex: https://seudominio.com,https://www.seudominio.com
ALLOWED_ORIGIN=

# (Opcional) Caminho do arquivo SQLite (padrão: ./data.sqlite)
DB_PATH=

# ---- Integração Cakto (Fase 2) ----
# Segredo do webhook: a Cakto deve enviar este valor em ?secret= ou no header x-cakto-secret.
CAKTO_WEBHOOK_SECRET=

# Mapeia a oferta da Cakto para produto/plano (JSON em uma linha).
# Ex: {"ID_OFERTA_STARTER":{"productSlug":"rizzai","plan":"starter"},"ID_OFERTA_PRO":{"productSlug":"rizzai","plan":"pro"}}
CAKTO_OFFER_MAP=
