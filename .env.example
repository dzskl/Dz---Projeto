# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).

# Porta do servidor
PORT=3000

# Chave da API do Google Gemini (obtida em https://aistudio.google.com/apikey)
GEMINI_API_KEY=cole_sua_chave_aqui

# Senha do painel de administração (use uma senha forte e única)
# Se não for definida, as rotas de admin ficam BLOQUEADAS por segurança.
ADMIN_PASSWORD=defina_uma_senha_forte_aqui
