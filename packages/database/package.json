{
  "name": "@tg/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/prisma.mjs generate",
    "migrate": "node scripts/prisma.mjs migrate dev",
    "deploy": "node scripts/prisma.mjs migrate deploy",
    "seed": "tsx src/seed.ts",
    "studio": "node scripts/prisma.mjs studio",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@tg/config": "workspace:*",
    "@tg/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
